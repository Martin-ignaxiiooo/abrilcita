# ============================================================
# Abrilcita - Variables de entorno (ejemplo)
# ============================================================
# Copia este archivo como .env y llena tus valores.
#
# Estas variables se usan en desplegues de Vercel.
# En Vercel: Project Settings -> Environment Variables,
# crea SUPABASE_URL y SUPABASE_ANON_KEY con estos valores.
#
# ⚠️ NUNCA subas tu .env real al repositorio (está en .gitignore)
# ============================================================

# Tu proyecto Supabase (Dashboard -> Settings -> API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (Settings -> API -> anon public key)
SUPABASE_ANON_KEY=TU_CLAVE_ANON_AQUI
